@page "/dungeons-admin"
@using System.Globalization
@using System.Reflection
@using MercenariesAndBeasts.Domain.Localization
@using Microsoft.EntityFrameworkCore
@using MercenariesAndBeasts.Domain.Utils
@using MercenariesAndBeasts.Domain.Combat
@attribute [Authorize(Roles = "Admin")]
@rendermode InteractiveServer

@inject IJSRuntime JS

<PageTitle>Dungeons Admin — Mercenaries & Beasts</PageTitle>

<div class="ui-page-header ui-anim-fade-up">
    <h3><i class="bi bi-layers"></i> @S["Dungeons"] Admin</h3>
</div>

<div class="ui-panel ui-anim-fade-up mb-3">
    <div class="fw-bold mb-2">Localization coverage <span class="text-muted small fw-normal">(locales: @_localeCount)</span></div>
    <div class="row g-2">
        <div class="col-md-6">
            <div class="text-muted small mb-1">Dungeons</div>
            <div>@_dungeonHaveRows / @_dungeonMaxRows rows
                (@(_dungeonMaxRows == 0 ? "0" : ((100.0 * _dungeonHaveRows / _dungeonMaxRows).ToString("0.0")))%)
                — full: <span class="@(_dungeonFullyLocalized == _dungeonTotal ? "text-success" : "text-warning")">@_dungeonFullyLocalized / @_dungeonTotal</span>
            </div>
        </div>
        <div class="col-md-6">
            <div class="text-muted small mb-1">Beasts (MonsterTemplates)</div>
            <div>@_beastHaveRows / @_beastMaxRows rows
                (@(_beastMaxRows == 0 ? "0" : ((100.0 * _beastHaveRows / _beastMaxRows).ToString("0.0")))%)
                — full: <span class="@(_beastFullyLocalized == _beastTotal ? "text-success" : "text-warning")">@_beastFullyLocalized / @_beastTotal</span>
                — items: @_beastWithItemTemplates / @_beastTotal
            </div>
        </div>
    </div>
</div>

<ImagePreviewer @ref="imagePreviewer" />

@if (isLoading)
{
    <PageLoadingSpinner />
}
else
{
    <div class="mb-3">
        <button class="btn btn-secondary" @onclick="() => GenerateNextDungeon(false)">
            Generate Next Dungeon (AI)
        </button>

        <div class="input-group mt-2">
            <input class="form-control dungeon-input"
                   @bind="manualDungeonName"
                   placeholder="Enter dungeon name…" />

            <button class="btn btn-primary"
                    disabled="@IsManualGenerateDisabled"
                    @onclick="async () => await GenerateNextDungeon(true)">
                Generate Dungeon (Manual)
            </button>
        </div>
    </div>

    @if (!dungeons.Any())
    {
        <p>No dungeons yet.</p>
    }
    else
    {
        <div class="table-scroll-x">
    <table class="table table-dark table-stages table-fixed w-100">
                <thead>
                    <tr>
                        <th>Code</th>
                        <th>Name</th>
                        <th>Element</th>
                        <th>Unlock Order</th>
                        <th>Level range</th>
                        <th>Stages</th>
                        <th>Preview</th>
                        <th>Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var d in dungeons)
                    {
                        @if (_editId == d.Guid)
                        {
                            <!-- Edit row -->
                            <tr class="table-warning text-dark">
                                <td>@d.Code</td>
                                <td colspan="2">
                                    <input class="form-control form-control-sm mb-1"
                                           placeholder="Name (EN)"
                                           @bind="_editForm.NameEn" />
                                    <select class="form-select form-select-sm"
                                            @bind="_editForm.Element">
                                        @foreach (var e in Enum.GetValues<ElementType>())
                                        {
                                            <option value="@e">@e</option>
                                        }
                                    </select>
                                </td>
                                <td>
                                    <input type="number" class="form-control form-control-sm"
                                           @bind="_editForm.UnlockOrder" min="1" />
                                </td>
                                <td>
                                    <div class="d-flex gap-1">
                                        <input type="number" class="form-control form-control-sm"
                                               placeholder="Min" @bind="_editForm.MinLevel" min="1" />
                                        <input type="number" class="form-control form-control-sm"
                                               placeholder="Max" @bind="_editForm.MaxLevel" min="1" />
                                    </div>
                                </td>
                                <td>
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" @bind="_editForm.IsActive" />
                                        <label class="form-check-label small">Active</label>
                                    </div>
                                </td>
                                <td>
                                    <textarea class="form-control form-control-sm" rows="2"
                                              placeholder="Description (EN)"
                                              @bind="_editForm.DescriptionEn"></textarea>
                                </td>
                                <td>
                                    <div class="d-flex gap-1 flex-wrap">
                                        <button class="btn btn-sm btn-success" @onclick="SaveEdit">
                                            <i class="bi bi-check-lg"></i> Uložit
                                        </button>
                                        <button class="btn btn-sm btn-secondary" @onclick="CancelEdit">
                                            Zrušit
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                        else
                        {
                            <tr>
                                <td title="@d.Code">@d.Code</td>

                                <td title="@d.NameForCurrentCulture(_dungeonLocs)"
                                    class="location-name ellipsis">
                                    @d.NameForCurrentCulture(_dungeonLocs)
                                </td>

                                <td>@d.Element</td>
                                <td>@d.UnlockOrder</td>
                                <td>@d.MinLevel - @d.MaxLevel</td>

                                <td>
                                    @(d.Stages?.Count ?? 0)
                                    <button class="btn btn-sm btn-outline-info ms-2"
                                            @onclick="() => ToggleDungeonStages(d.Guid)">
                                        @(expandedDungeonIds.Contains(d.Guid) ? "Hide" : "Show")
                                    </button>
                                </td>

                                <td style="width:150px;">
                                    @if (!string.IsNullOrWhiteSpace(d.ImagePath))
                                    {
                                        <img src="@d.ImagePath"
                                             class="img-thumbnail"
                                             style="max-height: 80px; cursor:pointer;"
                                             @onclick="() => ShowImage(d.ImagePath)" />
                                    }
                                    else
                                    {
                                        <span class="text-muted">No image</span>
                                    }

                                    <button class="btn btn-sm btn-outline-warning mt-1"
                                            @onclick="() => GenerateDungeonImage(d)">
                                        Generate Image
                                    </button>
                                </td>

                                <td>
                                    <div class="d-flex gap-1 flex-wrap">
                                        <button class="btn btn-sm btn-outline-light"
                                                @onclick="() => StartEdit(d)">
                                            <i class="bi bi-pencil"></i>
                                        </button>
                                        <button class="btn btn-sm btn-outline-danger"
                                                @onclick="() => DeleteDungeon(d)">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }

                        @if (expandedDungeonIds.Contains(d.Guid))
{
    <tr class="dungeon-detail-row">
        <td colspan="8" style="max-width:0;">
            <div class="mb-2 dungeon-description">
                @d.DescriptionForCurrentCulture(_dungeonLocs)
            </div>

            @if (d.Stages == null || d.Stages.Count == 0)
            {
                <em>No stages defined.</em>
            }
            else
            {
                <div class="accordion" id="acc-@d.Guid">
                    <div class="accordion-item bg-dark text-light">
                        <h2 class="accordion-header" id="heading-@d.Guid">
                            <button class="accordion-button collapsed"
                                    type="button"
                                    data-bs-toggle="collapse"
                                    data-bs-target="#collapse-@d.Guid"
                                    aria-expanded="false"
                                    aria-controls="collapse-@d.Guid">
                                Stages &amp; monsters
                            </button>
                        </h2>

                        <div id="collapse-@d.Guid"
                             class="accordion-collapse collapse show"
                             aria-labelledby="heading-@d.Guid">
                            <div class="accordion-body">

                                <!-- scroll wrapper for INNER stats table -->
                                <div class="table-scroll-x inner-scroll">
                <table class="table table-sm table-dark align-middle text-nowrap mb-0 inner-wide">
                                        <thead>
                                            <tr>
                                                <th class="">#</th>
                                                <th class="">Stage type</th>
                                                <th class="">Monster</th>
                                                <th class="">Level</th>
                                                <th class="">Element</th>

                                                @foreach (var col in StatColumns)
                                                {
                                                    <th class="">@col.Header</th>
                                                }
                                                <th></th>
                                            </tr>
                                        </thead>

                                        <tbody>
                                            @foreach (var s in d.Stages.OrderBy(s => s.StageIndex))
                                            {
                                                var mt = s.MonsterTemplate;
                                                <tr>
                                                    <td class="">@s.StageIndex</td>
                                                    <td class="">@s.StageType</td>

                                                    <td class=""
                                                        title="@(mt is null ? "" : mt.NameForCurrentCulture(_monsterLocs))">
                                                        @(mt is null ? "-" : mt.NameForCurrentCulture(_monsterLocs))
                                                    </td>

                                                    <td class="">@mt?.BaseLevel</td>
                                                    <td class="">@mt?.Element</td>

                                                    @foreach (var col in StatColumns)
                                                    {
                                                        <td class="">@FormatStat(col.GetValue(mt?.BaseStats))</td>
                                                    }
                                                    <td>
                                                        <button class="btn btn-sm btn-outline-danger"
                                                                @onclick="() => DeleteStage(s)">
                                                            <i class="bi bi-trash"></i>
                                                        </button>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>

                                <!-- Add Stage form -->
                                @if (_stageAddForDungeon == d.Guid)
                                {
                                    <div class="mt-3 p-3 border border-secondary rounded">
                                        <div class="fw-bold mb-2">Přidat stage</div>
                                        <div class="row g-2">
                                            <div class="col-auto">
                                                <label class="form-label small">StageIndex</label>
                                                <input type="number" class="form-control form-control-sm"
                                                       @bind="_stageAdd.StageIndex" min="1" style="width:80px;" />
                                            </div>
                                            <div class="col-auto">
                                                <label class="form-label small">StageType</label>
                                                <select class="form-select form-select-sm"
                                                        @bind="_stageAdd.StageType">
                                                    @foreach (var st in Enum.GetValues<DungeonStageType>())
                                                    {
                                                        <option value="@st">@st</option>
                                                    }
                                                </select>
                                            </div>
                                            <div class="col-auto">
                                                <label class="form-label small">RecommendedLevel</label>
                                                <input type="number" class="form-control form-control-sm"
                                                       @bind="_stageAdd.RecommendedLevel" min="1" style="width:80px;" />
                                            </div>
                                            <div class="col-md-4">
                                                <label class="form-label small">Monster Template</label>
                                                <select class="form-select form-select-sm"
                                                        @bind="_stageAdd.MonsterTemplateId">
                                                    <option value="@Guid.Empty">— vybrat —</option>
                                                    @foreach (var mt in _monsterTemplates)
                                                    {
                                                        <option value="@mt.Guid">@mt.NameEn (@mt.Element, Lv@mt.BaseLevel)</option>
                                                    }
                                                </select>
                                            </div>
                                            <div class="col-auto align-self-end">
                                                <button class="btn btn-sm btn-success me-1"
                                                        disabled="@(_stageAdd.MonsterTemplateId == Guid.Empty)"
                                                        @onclick="() => SaveStage(d.Guid)">
                                                    <i class="bi bi-plus-circle"></i> Přidat
                                                </button>
                                                <button class="btn btn-sm btn-secondary"
                                                        @onclick="() => _stageAddForDungeon = null">
                                                    Zrušit
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    <button class="btn btn-sm btn-outline-success mt-2"
                                            @onclick="() => StartAddStage(d.Guid, d.Stages?.Count ?? 0)">
                                        <i class="bi bi-plus-circle"></i> Přidat stage
                                    </button>
                                }

                            </div>
                        </div>
                    </div>
                </div>
            }

            <!-- Always show add-stage option if no stages yet -->
            @if (d.Stages == null || d.Stages.Count == 0)
            {
                @if (_stageAddForDungeon == d.Guid)
                {
                    <div class="mt-3 p-3 border border-secondary rounded">
                        <div class="fw-bold mb-2">Přidat první stage</div>
                        <div class="row g-2">
                            <div class="col-auto">
                                <label class="form-label small">StageIndex</label>
                                <input type="number" class="form-control form-control-sm"
                                       @bind="_stageAdd.StageIndex" min="1" style="width:80px;" />
                            </div>
                            <div class="col-auto">
                                <label class="form-label small">StageType</label>
                                <select class="form-select form-select-sm"
                                        @bind="_stageAdd.StageType">
                                    @foreach (var st in Enum.GetValues<DungeonStageType>())
                                    {
                                        <option value="@st">@st</option>
                                    }
                                </select>
                            </div>
                            <div class="col-auto">
                                <label class="form-label small">RecommendedLevel</label>
                                <input type="number" class="form-control form-control-sm"
                                       @bind="_stageAdd.RecommendedLevel" min="1" style="width:80px;" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label small">Monster Template</label>
                                <select class="form-select form-select-sm"
                                        @bind="_stageAdd.MonsterTemplateId">
                                    <option value="@Guid.Empty">— vybrat —</option>
                                    @foreach (var mt in _monsterTemplates)
                                    {
                                        <option value="@mt.Guid">@mt.NameEn (@mt.Element, Lv@mt.BaseLevel)</option>
                                    }
                                </select>
                            </div>
                            <div class="col-auto align-self-end">
                                <button class="btn btn-sm btn-success me-1"
                                        disabled="@(_stageAdd.MonsterTemplateId == Guid.Empty)"
                                        @onclick="() => SaveStage(d.Guid)">
                                    <i class="bi bi-plus-circle"></i> Přidat
                                </button>
                                <button class="btn btn-sm btn-secondary"
                                        @onclick="() => _stageAddForDungeon = null">
                                    Zrušit
                                </button>
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <button class="btn btn-sm btn-outline-success mt-2"
                            @onclick="() => StartAddStage(d.Guid, 0)">
                        <i class="bi bi-plus-circle"></i> Přidat stage
                    </button>
                }
            }
        </td>
    </tr>
}
                    }
                </tbody>
            </table>
        </div>
    }
}

@code {
    private bool isLoading = true;

    private List<Dungeon> dungeons = new();
    private List<MonsterTemplate> _monsterTemplates = new();

    private string manualDungeonName = string.Empty;
    private bool IsManualGenerateDisabled => isLoading || string.IsNullOrWhiteSpace(manualDungeonName);

    private HashSet<Guid> expandedDungeonIds = new();

    // localizations loaded in bulk
    private List<LocalizedText> _dungeonLocs = new();
    private List<LocalizedText> _monsterLocs = new();

    private ImagePreviewer? imagePreviewer;

    // ===== Edit dungeon =====
    private Guid? _editId;
    private DungeonEditForm _editForm = new();

    // ===== Stage add =====
    private Guid? _stageAddForDungeon;
    private StageAddForm _stageAdd = new();

    // ===== Coverage metrics =====
    private int _localeCount;

    private int _dungeonHaveRows;
    private int _dungeonMaxRows;
    private int _dungeonFullyLocalized;
    private int _dungeonTotal;

    private int _beastHaveRows;
    private int _beastMaxRows;
    private int _beastFullyLocalized;
    private int _beastTotal;
    private int _beastWithItemTemplates;

    // kolik "polí" počítáš za 1 LocalizedText řádek (Name + Description)
    private const int LocFieldsPerCulture = 2;

    protected override async Task OnInitializedAsync()
    {
        await LoadDungeons();
    }

    private async Task LoadDungeons()
    {
        isLoading = true;

        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            dungeons = await db.Dungeons
                .Include(x => x.Stages).ThenInclude(x => x.MonsterTemplate)
                .OrderBy(d => d.MinLevel)
                .ThenBy(d => d.Code)
                .ToListAsync();

            _monsterTemplates = await db.MonsterTemplates
                .AsNoTracking()
                .OrderBy(m => m.BaseLevel)
                .ThenBy(m => m.NameEn)
                .ToListAsync();

            // načti lokalizace + spočítej coverage (v separátním kontextu)
            await using var db2 = await DbFactory.CreateDbContextAsync();
            await LoadLocalizationsAndCoverageAsync(db2);

            Toasts.Success("Dungeons loaded", $"Loaded {dungeons.Count} dungeons.");
        }
        catch (Exception ex)
        {
            Toasts.Error("Failed to load dungeons", ex.Message);
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    // ===========================
    // EDIT dungeon
    // ===========================

    private void StartEdit(Dungeon d)
    {
        _editId = d.Guid;
        _editForm = new DungeonEditForm
        {
            NameEn = d.NameEn,
            DescriptionEn = d.DescriptionEn,
            Element = d.Element,
            UnlockOrder = d.UnlockOrder,
            MinLevel = d.MinLevel,
            MaxLevel = d.MaxLevel,
            IsActive = d.IsActive
        };
    }

    private void CancelEdit()
    {
        _editId = null;
    }

    private async Task SaveEdit()
    {
        if (_editId is null) return;

        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var dbDungeon = await db.Dungeons.FirstOrDefaultAsync(x => x.Guid == _editId.Value);
            if (dbDungeon is null) { Toasts.Error("Kobka nenalezena.", "Admin"); return; }

            dbDungeon.NameEn = _editForm.NameEn;
            dbDungeon.DescriptionEn = _editForm.DescriptionEn;
            dbDungeon.Element = _editForm.Element;
            dbDungeon.UnlockOrder = _editForm.UnlockOrder;
            dbDungeon.MinLevel = _editForm.MinLevel;
            dbDungeon.MaxLevel = _editForm.MaxLevel;
            dbDungeon.IsActive = _editForm.IsActive;

            await db.SaveChangesAsync();
            _editId = null;
            Toasts.Success("Kobka uložena", _editForm.NameEn);
            await LoadDungeons();
        }
        catch (Exception ex)
        {
            Toasts.Error("Chyba při ukládání", ex.Message);
        }
    }

    private async Task DeleteDungeon(Dungeon d)
    {
        var confirmed = await JS.InvokeAsync<bool>("confirm", $"Opravdu smazat kobku '{d.NameEn}'? Tato akce smaže i všechny stages.");
        if (!confirmed) return;

        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var dbDungeon = await db.Dungeons
                .Include(x => x.Stages)
                .FirstOrDefaultAsync(x => x.Guid == d.Guid);
            if (dbDungeon is null) { Toasts.Error("Kobka nenalezena.", "Admin"); return; }

            db.DungeonStages.RemoveRange(dbDungeon.Stages);
            db.Dungeons.Remove(dbDungeon);
            await db.SaveChangesAsync();

            Toasts.Warning($"Kobka smazána: {d.NameEn}", "Admin");
            await LoadDungeons();
        }
        catch (Exception ex)
        {
            Toasts.Error("Chyba při mazání", ex.Message);
        }
    }

    // ===========================
    // STAGE management
    // ===========================

    private void StartAddStage(Guid dungeonId, int currentCount)
    {
        _stageAddForDungeon = dungeonId;
        _stageAdd = new StageAddForm
        {
            StageIndex = currentCount + 1,
            StageType = DungeonStageType.DS1_Feeble,
            RecommendedLevel = 1
        };
    }

    private async Task SaveStage(Guid dungeonId)
    {
        if (_stageAdd.MonsterTemplateId == Guid.Empty) return;

        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();

            var stage = new DungeonStage
            {
                DungeonId = dungeonId,
                StageIndex = _stageAdd.StageIndex,
                StageType = _stageAdd.StageType,
                MonsterTemplateId = _stageAdd.MonsterTemplateId,
                RecommendedLevel = _stageAdd.RecommendedLevel,
                NameEn = $"Stage {_stageAdd.StageIndex}",
                Code = $"stage_{_stageAdd.StageIndex}_{dungeonId.ToString("N")[..8]}"
            };

            db.DungeonStages.Add(stage);
            await db.SaveChangesAsync();

            _stageAddForDungeon = null;
            Toasts.Success("Stage přidána", $"Stage {_stageAdd.StageIndex}");
            await LoadDungeons();
        }
        catch (Exception ex)
        {
            Toasts.Error("Chyba při přidávání stage", ex.Message);
        }
    }

    private async Task DeleteStage(DungeonStage stage)
    {
        var confirmed = await JS.InvokeAsync<bool>("confirm", $"Opravdu smazat stage #{stage.StageIndex}?");
        if (!confirmed) return;

        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var dbStage = await db.DungeonStages.FirstOrDefaultAsync(x => x.Guid == stage.Guid);
            if (dbStage is null) { Toasts.Error("Stage nenalezena.", "Admin"); return; }

            db.DungeonStages.Remove(dbStage);
            await db.SaveChangesAsync();

            Toasts.Warning($"Stage #{stage.StageIndex} smazána.", "Admin");
            await LoadDungeons();
        }
        catch (Exception ex)
        {
            Toasts.Error("Chyba při mazání stage", ex.Message);
        }
    }

    // ===========================
    // LOCALIZATION coverage
    // ===========================

    private async Task LoadLocalizationsAndCoverageAsync(AppDbContextMercenariesAndBeasts db)
    {
        _localeCount = LocalizationConfig.SupportedLocales.Length;

        var dungeonIds = dungeons.Select(x => x.Guid).ToList();

        var monsterIds = dungeons
            .SelectMany(d => d.Stages ?? new List<DungeonStage>())
            .Select(s => s.MonsterTemplateId)
            .Distinct()
            .ToList();

        _dungeonLocs = dungeonIds.Count == 0
            ? new()
            : await db.LocalizedTexts
                .Where(x => x.EntityType == nameof(Dungeon) && dungeonIds.Contains(x.EntityId))
                .ToListAsync();

        _monsterLocs = monsterIds.Count == 0
            ? new()
            : await db.LocalizedTexts
                .Where(x => x.EntityType == nameof(MonsterTemplate) && monsterIds.Contains(x.EntityId))
                .ToListAsync();

        // ===== DUNGEONS coverage =====
        _dungeonTotal = dungeonIds.Count;
        _dungeonMaxRows = _dungeonTotal * _localeCount * LocFieldsPerCulture;
        _dungeonHaveRows = CountHaveRows_NameDesc(_dungeonLocs);
        _dungeonFullyLocalized = CountFullyLocalized_NameDesc_Strict(dungeonIds, _dungeonLocs);

        // ===== BEASTS coverage =====
        _beastTotal = monsterIds.Count;
        _beastMaxRows = _beastTotal * _localeCount * LocFieldsPerCulture;
        _beastHaveRows = CountHaveRows_NameDesc(_monsterLocs);
        _beastFullyLocalized = CountFullyLocalized_NameDesc_Strict(monsterIds, _monsterLocs);

        // has ItemTemplate (pro beasty)
        _beastWithItemTemplates = _beastTotal == 0
            ? 0
            : await db.ItemTemplates
                .Where(t => t.MonsterTemplateId != null && monsterIds.Contains(t.MonsterTemplateId.Value))
                .Select(t => t.MonsterTemplateId!.Value)
                .Distinct()
                .CountAsync();
    }

    private static int CountHaveRows_NameDesc(List<LocalizedText> rows)
    {
        var supported = LocalizationConfig.SupportedLocales.ToHashSet(StringComparer.OrdinalIgnoreCase);

        int count = 0;
        foreach (var r in rows)
        {
            if (!supported.Contains(r.Culture))
                continue;

            if (!string.IsNullOrWhiteSpace(r.Name))
                count++;

            if (!string.IsNullOrWhiteSpace(r.Description))
                count++;
        }

        return count;
    }

    private static int CountFullyLocalized_NameDesc_Strict(List<Guid> entityIds, List<LocalizedText> rows)
    {
        if (entityIds.Count == 0) return 0;

        var locales = LocalizationConfig.SupportedLocales;

        var byEntity = rows
            .GroupBy(x => x.EntityId)
            .ToDictionary(g => g.Key, g => g.ToList());

        int full = 0;

        foreach (var id in entityIds)
        {
            if (!byEntity.TryGetValue(id, out var list))
                continue;

            bool ok = true;

            foreach (var loc in locales)
            {
                var hit = list.FirstOrDefault(x => x.Culture.Equals(loc, StringComparison.OrdinalIgnoreCase));
                if (hit is null)
                {
                    ok = false;
                    break;
                }

                if (string.IsNullOrWhiteSpace(hit.Name) || string.IsNullOrWhiteSpace(hit.Description))
                {
                    ok = false;
                    break;
                }
            }

            if (ok) full++;
        }

        return full;
    }

    private void ToggleDungeonStages(Guid dungeonId)
    {
        if (expandedDungeonIds.Contains(dungeonId))
            expandedDungeonIds.Remove(dungeonId);
        else
            expandedDungeonIds.Add(dungeonId);
    }

    private void ShowImage(string? url)
    {
        if (!string.IsNullOrWhiteSpace(url))
            imagePreviewer?.Open(url);
    }

    private async Task GenerateNextDungeon(bool current)
    {
        isLoading = true;
        await using var db = await DbFactory.CreateDbContextAsync();
        try
        {
            var newDungeon = new Dungeon();

            var lastDungeon = await db.Dungeons
                .OrderByDescending(d => d.UnlockOrder)
                .FirstOrDefaultAsync();

            if (lastDungeon is null)
            {
                newDungeon.MinLevel = 1;
                newDungeon.MaxLevel = 5;
            }
            else
            {
                newDungeon.MinLevel = lastDungeon.MinLevel;
                newDungeon.MaxLevel = lastDungeon.MaxLevel;
            }

            if (current)
                newDungeon.NameEn = manualDungeonName.Trim();

            var dungeon = await DungeonAi.GenerateNextDungeonAsync(lastDungeon!, newDungeon, current, "", CancellationToken.None);
            if (dungeon is null)
            {
                Toasts.Error("AI generation failed", "No dungeon was generated.");
                return;
            }

            await db.SaveChangesAsync();
            await LoadDungeons();

            Toasts.Success("Dungeon created", dungeon.NameEn);
        }
        catch (Exception ex)
        {
            Toasts.Error("Failed to generate dungeon", ex.Message);
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task GenerateDungeonImage(Dungeon d)
    {
        isLoading = true;
        StateHasChanged();

        await using var db = await DbFactory.CreateDbContextAsync();
        try
        {
            var path = await ImageAi.GenerateDungeonImageAsync(d);
            if (string.IsNullOrWhiteSpace(path))
            {
                Toasts.Error("Image generation failed", "AI did not return any image.");
                return;
            }

            // reload tracked entity and update
            var dbDungeon = await db.Dungeons.FirstAsync(x => x.Guid == d.Guid);
            dbDungeon.ImagePath = path;

            await db.SaveChangesAsync();
            await LoadDungeons();

            Toasts.Success("Dungeon image generated", d.NameEn);
        }
        catch (Exception ex)
        {
            Toasts.Error("Failed to generate dungeon image", ex.Message);
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    // ===========================
    // STAT TABLE (reflection)
    // ===========================
    private sealed record StatCol(string Header, Func<StatBlock?, object?> GetValue);
    private static readonly List<StatCol> StatColumns = BuildStatColumns();

    private static List<StatCol> BuildStatColumns()
    {
        var t = typeof(StatBlock);

        var props = t.GetProperties(BindingFlags.Instance | BindingFlags.Public)
            .Where(p => p.CanRead &&
                        (p.PropertyType == typeof(int) ||
                         p.PropertyType == typeof(long) ||
                         p.PropertyType == typeof(float) ||
                         p.PropertyType == typeof(double)) &&
                        p.Name != nameof(StatBlock.Element)) // element máš jako vlastní sloupec
            .OrderBy(p => p.Name)
            .ToList();

        var cols = new List<StatCol>(props.Count);
        foreach (var p in props)
        {
            cols.Add(new StatCol(
                Header: p.Name,
                GetValue: sb => sb is null ? null : p.GetValue(sb)
            ));
        }

        return cols;
    }

    private static string FormatStat(object? v)
    {
        if (v is null) return "-";

        if (v is int i && i == 0) return "-";
        if (v is long l && l == 0) return "-";
        if (v is float f && Math.Abs(f) < 0.0001f) return "-";
        if (v is double d && Math.Abs(d) < 0.0001) return "-";

        return v switch
        {
            double d2 => d2.ToString("0.###", CultureInfo.InvariantCulture),
            float f2 => f2.ToString("0.###", CultureInfo.InvariantCulture),
            _ => v.ToString() ?? "-"
        };
    }

